{
  "name": "lua-cli",
  "version": "3.16.0",
  "description": "Build, test, and deploy AI agents with custom tools, webhooks, and scheduled jobs. Features LuaAgent unified configuration, streaming chat, and batch deployment.",
  "readmeFilename": "README.md",
  "main": "dist/api-exports.js",
  "bin": {
    "lua": "./dist/index.js",
    "heylua": "./dist/index.js",
    "lua-ai": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/api-exports.d.ts",
      "default": "./dist/api-exports.js"
    },
    "./voice": {
      "types": "./dist/voice-exports.d.ts",
      "default": "./dist/voice-exports.js"
    },
    "./voice/test": {
      "types": "./dist/voice/test/index.d.ts",
      "default": "./dist/voice/test/index.js"
    }
  },
  "keywords": [
    "lua",
    "ai",
    "cli",
    "command-line",
    "automation",
    "agents",
    "api",
    "typescript",
    "tools",
    "bundling",
    "testing",
    "deployment",
    "skills"
  ],
  "author": "Stefan Kruger <stefan@heylua.ai>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lua-ai-global/lua-core-services.git",
    "directory": "packages/lua-cli"
  },
  "homepage": "https://github.com/lua-ai-global/lua-core-services/tree/main/packages/lua-cli#readme",
  "readme": "README.md",
  "bugs": {
    "url": "https://github.com/lua-ai-global/lua-cli/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist/**/*",
    "template/**/*",
    "docs/**/*",
    "scripts/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@livekit/agents": "^1.4.2",
    "@livekit/agents-plugin-deepgram": "^1.4.2",
    "@livekit/agents-plugin-elevenlabs": "^1.4.2",
    "@livekit/agents-plugin-google": "^1.4.2",
    "@livekit/agents-plugin-openai": "^1.4.2",
    "@livekit/agents-plugin-xai": "^1.4.2",
    "@livekit/rtc-node": "^0.13.27",
    "@tailwindcss/postcss": "^4.1.14",
    "@tanstack/react-query": "^5.90.11",
    "@truestamp/canonify": "^2.1.0",
    "ai": "^5.0.76",
    "autoprefixer": "^10.4.21",
    "chalk": "^5.3.0",
    "commander": "^14.0.1",
    "diff": "^8.0.2",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.10",
    "inquirer": "^12.9.6",
    "js-yaml": "^4.1.0",
    "open": "^10.1.0",
    "posthog-node": "^5.26.0",
    "ts-evaluator": "^2.0.0",
    "ts-morph": "^27.0.0",
    "typescript": "^5.9.2",
    "undici": "^6.21.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.7",
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/diff": "^7.0.2",
    "@types/inquirer": "^9.0.9",
    "@types/jest": "^29.5.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.5.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@typescript-eslint/typescript-estree": "^8.44.1",
    "jest": "^29.7.0",
    "lodash": "^4.17.21",
    "nock": "^14.0.11",
    "stripe": "^19.2.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "@lua/shared-types": "0.0.1",
    "@lua/shared-source-sync": "0.0.1",
    "@lua/shared-sandbox": "0.0.1"
  },
  "scripts": {
    "clean": "rm -rf dist temp",
    "build": "npm run clean && tsup && npm run build:vendor && npm run build:dts && npm run build:dts-rollup && chmod +x dist/index.js",
    "build:vendor": "node scripts/build-vendor.mjs",
    "build:dts": "tsc -p tsconfig.build.json",
    "build:dts-rollup": "node scripts/run-api-extractor.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  }
}